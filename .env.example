# WonderWorld VR — environment variables (copy to .env.local)
# The MVP runs entirely in local demo mode and needs NO variables.

# Phase 5 (not implemented yet): Node API base URL. When unset, progress is stored in localStorage.
# VITE_API_URL=http://localhost:8787

# Playwright: browser channel for e2e tests. Defaults to the installed Google Chrome.
# Set to an empty value to use Playwright's bundled Chromium (requires `npx playwright install chromium`).
# PW_CHANNEL=chrome
